+.ladder-card {
+  border: 1px solid var(--color-border);
+  border-radius: clamp(1.25rem, 3.1vw, 3rem);
+  background: var(--color-surface);
+  box-shadow: 0 0.2rem 0.65rem
+    color-mix(in srgb, var(--color-text) 12%, transparent);
+}
+
+.ladder-card__title {
+  margin: 0;
+  font-size: clamp(1.65rem, 2.75vw, 3rem);
+  line-height: 1.15;
+  text-wrap: balance;
+}
+
+.ladder-card__pill {
+  width: fit-content;
+  margin: 0;
+  padding: 0.4em 0.85em;
+  border-radius: 2rem;
+  background: var(--color-highlight);
+  font-size: clamp(1.05rem, 1.65vw, 1.55rem);
+  line-height: 1.25;
+}
