{
  "name": "project-adhd-ladder",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names client,server \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace client --",
    "dev:server": "npm run dev --workspace server --",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "preview": "npm run preview --workspace client --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
